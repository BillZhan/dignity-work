# --- Supabase 配置（不填则使用本地 mock 数据） ---
# 留空或者注释掉都可以表示本地模式
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ============================================================
# ⚠️ 服务端密钥（必须配置，不能用 NEXT_PUBLIC_ 前缀！）
# 这些值只在 Cloudflare Pages Functions 中可见，不会被打包进前端 JS
# ============================================================

# 后台管理员密码（必填，至少 12 位强密码）
# 在 Cloudflare Pages → Settings → Environment variables 中设置
#   Production + Preview 都设上，建议两个值不同
ADMIN_PASSWORD=

# 会话签名密钥（可选；不填则用 ADMIN_PASSWORD 作为签名密钥）
# 推荐设置一个独立的强随机字符串，让会话 cookie 无法被反推
SESSION_SECRET=